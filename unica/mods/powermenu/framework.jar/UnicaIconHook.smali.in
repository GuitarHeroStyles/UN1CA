.class public final Lcom/samsung/android/globalactions/presentation/viewmodel/UnicaIconHook;
.super Ljava/lang/Object;

.method public static applyIcon(Ljava/lang/Object;Landroid/view/View;)V
    .locals 4

    :try_start_0
    check-cast p0, @ITEM_CLS@

